+
+	if (m_flags & ShowPreset)
+	{
+		presetLayoutComboBox->setEnabled(m_facingPages);
+
+		if (m_facingPages)
+			setPreset();
+		else
+			setInternalState(m_pageWidth, m_pageHeight, m_marginData, m_savedPresetItem);
+	}
